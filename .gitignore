# Node dependencies
node_modules

# CDK asset staging directory / synth output
.cdk.staging
cdk.out

# Generated TypeScript output (tsc). Targeted so frontend source is NOT ignored.
*.d.ts
# The frontend keeps a hand-written ambient type declaration in source.
!frontend/src/vite-env.d.ts
bin/*.js
lib/*.js
lambda/*.js

# Test coverage
coverage

# Logs
*.log

# OS files
.DS_Store

# Frontend (React + Vite + TypeScript app under frontend/). Ignore build output
# and installed dependencies, but keep the frontend SOURCE tracked.
frontend/node_modules
frontend/dist

# Local env files for the Vite app (keep frontend/.env.example tracked).
frontend/.env
frontend/.env.local
frontend/*.local
