# フロントエンド（Vite）のクライアント環境変数。
# ローカル開発では、このファイルを .env.local にコピーして実際の値を設定してください。
#   cp .env.example .env.local
#
# 本番（Amplify Hosting）では、amplify.yml のビルドが Amplify コンソールの
# 環境変数（API_BASE / COGNITO_DOMAIN / COGNITO_CLIENT_ID）から frontend/.env を
# 生成し、以下の VITE_* にマッピングします。手動設定は不要です。

# API のベース URL（CDK CfnOutput の ApiEndpoint + '/api'）。
# 空文字の場合は同一オリジンの '/api' が既定になります。
VITE_API_BASE=https://xxxx.execute-api.ap-northeast-1.amazonaws.com/api

# Cognito Hosted UI のベース URL（CDK CfnOutput の UserPoolHostedUiDomain）。
VITE_COGNITO_DOMAIN=https://your-prefix.auth.ap-northeast-1.amazoncognito.com

# Cognito のパブリックアプリクライアント ID（CDK CfnOutput の UserPoolClientId）。
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# リアルタイム対戦の WebSocket エンドポイント（CDK CfnOutput の WebSocketEndpoint）。
VITE_WS_URL=wss://xxxx.execute-api.ap-northeast-1.amazonaws.com/prod
